{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "karama-labs-web",
  "compatibility_date": "2026-09-19",
  "routes": [
    {
      "pattern": "karamalabs.com/*",
      "zone_name": "karamalabs.com"
    },
    {
      "pattern": "www.karamalabs.com/*",
      "zone_name": "karamalabs.com"
    }
  ],
  "assets": {
    "directory": "./out"
  },
  "observability": {
    "enabled": true
  }
}
